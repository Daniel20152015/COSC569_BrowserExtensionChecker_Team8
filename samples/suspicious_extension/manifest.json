{
    "manifest_version": 3,
    "name": "Suspicious Test Extension",
    "version": "1.0",
    "description": "Test extension containing sensitive DOM access",

    "permissions": [
        "storage"
    ],

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}